{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci --workspace=@meldshell/site --include-workspace-root=false --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm run build --workspace=@meldshell/site",
  "outputDirectory": "apps/site/dist",
  "ignoreCommand": "sh scripts/vercel-ignore.sh"
}
