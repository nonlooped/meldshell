BETTER_AUTH_URL=http://localhost:3001
MELDSHELL_SITE_URL=http://localhost:4321
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
MELDSHELL_ACCOUNT_DATABASE=./data/accounts.sqlite
PORT=3001
BIND_ADDRESS=127.0.0.1
# Register BETTER_AUTH_URL/api/auth/callback/google as a Google redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required in production for email verification and password recovery.
SMTP_URL=
SMTP_FROM=
# Set production behind an HTTPS reverse proxy.
NODE_ENV=development
# Enable only when the service is reachable exclusively through a proxy that replaces X-Forwarded-For.
MELDSHELL_TRUST_PROXY=0
