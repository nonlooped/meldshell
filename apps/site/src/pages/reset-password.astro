---
import AccountPage from "../components/AccountPage.astro"
---

<AccountPage title="Choose a new password" description="Recover your MeldShell account.">
  <a slot="nav" href="/sign-in">Sign in</a>

  <section id="form-view" class="grid gap-5">
    <div>
      <h1>Choose a new password</h1>
      <p class="lede">You’ll be signed out of other browsers. Computers connected to MeldShell stay connected.</p>
    </div>
    <form id="reset" novalidate>
      <label class="field">
        New password
        <input name="password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
        <span class="hint">At least 12 characters.</span>
      </label>
      <label class="field">
        Confirm new password
        <input name="confirm" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
      </label>
      <p class="notice" data-tone="error" role="alert" id="error"></p>
      <button type="submit" class="btn btn-primary btn-block">Save password</button>
    </form>
  </section>

  <section id="invalid-view" class="result" hidden>
    <h1>This link doesn’t work</h1>
    <p class="lede">Password reset links expire and can be used once. Request a new one from the sign-in page.</p>
    <a class="btn btn-primary" href="/sign-in">Go to sign in</a>
  </section>

  <section id="done-view" class="result" hidden>
    <span class="result-icon" data-tone="success" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>
    </span>
    <h1>Password saved</h1>
    <p class="lede">Sign in with your new password to continue.</p>
    <a class="btn btn-primary" href="/sign-in">Sign in</a>
  </section>

  <script>
    import { accountRequest, describe } from "../remote/accounts"

    const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!
    const form = $<HTMLFormElement>("#reset")
    const error = $("#error")
    const token = new URL(location.href).searchParams.get("token")
    const show = (view: "form" | "invalid" | "done") => {
      for (const name of ["form", "invalid", "done"]) $(`#${name}-view`).hidden = name !== view
    }
    if (!token || new URL(location.href).searchParams.get("error")) show("invalid")

    form.addEventListener("submit", (event) => {
      event.preventDefault()
      error.textContent = ""
      if (!form.reportValidity()) return
      const fields = new FormData(form)
      if (fields.get("password") !== fields.get("confirm")) {
        error.textContent = "The passwords don’t match."
        form.querySelector<HTMLInputElement>("[name=confirm]")!.focus()
        return
      }
      const button = form.querySelector("button")!
      button.disabled = true
      button.setAttribute("aria-busy", "true")
      void accountRequest("/api/auth/reset-password", { token, newPassword: fields.get("password") })
        .then(() => show("done"))
        .catch((cause) => {
          const message = describe(cause)
          if (/token/i.test(message)) show("invalid")
          else error.textContent = message
        })
        .finally(() => {
          button.disabled = false
          button.removeAttribute("aria-busy")
        })
    })
  </script>
</AccountPage>
