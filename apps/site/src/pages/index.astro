---
import AppWindow from "../components/AppWindow.astro"
import BrandIcon from "../components/BrandIcon.astro"
import Features from "../components/Features.astro"
import Header from "../components/Header.astro"
import Lucide from "../components/Lucide.astro"
import Layout from "../layouts/Layout.astro"

const repo = "https://github.com/nonlooped/meldshell"
const releases = `${repo}/releases`
---

<Layout
  title="MeldShell: Codex, Claude Code and Cursor side by side"
  description="Run Codex, Claude Code and Cursor side by side across all your projects. MeldShell keeps every coding agent conversation in one desktop app."
  softwareApplication
>
  <Header {repo} />

  <main>
    <section class="hero relative flex flex-col sm:min-h-svh" aria-labelledby="hero-heading" data-hero>
      <script is:inline>
        /* Start hidden before first paint so the meld plays from the beginning. */
        document.currentScript.parentElement.dataset.meld = matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "together"
          : "hidden"
      </script>
      <div class="mx-auto w-full max-w-[1200px] px-5 sm:px-8 pt-14 sm:pt-20">
        <h1 id="hero-heading" class="display text-[clamp(44px,7.6vw,108px)] leading-[0.94]">
          <span class="line line-1">Your coding agents,</span><br />
          <span class="line line-2">side by side.</span>
        </h1>
        <div class="mt-7 sm:mt-9 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <p class="prose-lede max-w-[40ch]">
            Codex, Claude Code and Cursor on one desktop, each in its own native session.
          </p>
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <a href={`${releases}/latest`} data-download class="btn btn-primary" data-motion-link="download">
              <span data-download-icon="default" class="contents"><Lucide name="ArrowDownToLine" size={16} strokeWidth={2} /></span>
              <span data-download-icon="Windows" class="hidden"><BrandIcon name="windows" size={16} mono /></span>
              <span data-download-icon="Linux" class="hidden"><BrandIcon name="linux" size={16} mono /></span>
              <span data-download-label>View downloads</span>
            </a>
            <a href="/dashboard" class="btn btn-secondary">
              <Lucide name="MonitorSmartphone" size={16} strokeWidth={2} />
              Your devices
            </a>
          </div>
        </div>
      </div>

      <div class="relative mt-12 sm:mt-16 flex-1 px-3 sm:px-8 pb-0 sm:pb-6" aria-label="The MeldShell window">
        <div
          aria-hidden="true"
          class="glow pointer-events-none absolute inset-x-0 top-[8%] mx-auto h-[70%] max-w-[1100px] rounded-full blur-[110px] [background:conic-gradient(from_200deg,var(--color-spin-top),var(--color-spin-middle),var(--color-spin-bottom),var(--color-spin-top))]"
        ></div>
        <div class="relative mx-auto max-w-[1200px]">
          <AppWindow />
        </div>
      </div>
    </section>

    <Features class="mt-8 sm:mt-36 mb-24 sm:mb-32" />
  </main>
  <script>
    import "../scripts/release"
  </script>
</Layout>

<style>
  .line {
    display: inline-block;
  }
  .glow {
    opacity: 0;
    transition: opacity 1.4s 0.3s;
  }
  [data-meld="together"] .glow {
    opacity: 0.18;
  }
  .hero:not([data-meld]) .glow {
    opacity: 0.18;
  }
</style>
