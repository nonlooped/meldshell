---
import AccountPage from "../components/AccountPage.astro"
import Wordmark from "../components/Wordmark.astro"
---

<AccountPage title="Sign in" description="Sign in to reach the computers running MeldShell." variant="site">
  <section class="signin" aria-labelledby="title">
    <div class="signin-copy">
      <h1 id="title" class="display">Sign in to your computers.</h1>
      <p class="prose-lede" id="lede">Pick up your agents from any browser. Your files, conversations and provider logins stay on your computers.</p>
    </div>

    <div class="signin-stage">
      <div aria-hidden="true" class="signin-glow"></div>
      <div class="ui-window signin-window">
        <div class="signin-titlebar">
          <Wordmark size={16} />
          <span>Sign in to MeldShell</span>
        </div>
        <div class="signin-body">
          <div class="grid gap-3" id="providers">
            <button type="button" class="btn btn-primary provider" data-provider="google">
              <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.2-.1-2.3-.4-3.5z"/></svg>
              <span>Continue with Google</span>
            </button>
            <button type="button" class="btn btn-secondary provider" data-provider="discord">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="#5865F2" d="M20.317 4.37a19.8 19.8 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.3 18.3 0 0 0-5.487 0a13 13 0 0 0-.617-1.25a.08.08 0 0 0-.079-.037A19.7 19.7 0 0 0 3.677 4.37a.1.1 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.08.08 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.08.08 0 0 0 .084-.028a14 14 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13 13 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10 10 0 0 0 .372-.292a.07.07 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.07.07 0 0 1 .078.01q.181.149.373.292a.077.077 0 0 1-.006.127a12.3 12.3 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.08.08 0 0 0 .084.028a19.8 19.8 0 0 0 6.002-3.03a.08.08 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.03M8.02 15.33c-1.182 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418m7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418"/></svg>
              <span>Continue with Discord</span>
            </button>
          </div>
          <p class="notice" data-tone="error" role="alert" id="error"></p>
          <p class="muted">New here? Choosing a provider creates your account. Providers that share a verified email sign in to the same account.</p>
        </div>
      </div>
    </div>
  </section>

  <style is:global>
    .signin { display: grid; gap: 3rem; align-items: center; align-self: center; }
    @media (min-width: 960px) { .signin { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 4rem; } }
    .account .signin h1 { font-size: clamp(44px, 6vw, 84px); line-height: .94; font-weight: 500; letter-spacing: -.03em; }
    .signin .prose-lede { margin-top: 1.75rem; max-width: 38ch; }
    .signin-stage { position: relative; width: 100%; max-width: 30rem; justify-self: center; }
    @media (min-width: 960px) { .signin-stage { justify-self: end; } }
    .signin-glow { position: absolute; inset: -10% -15%; z-index: -1; pointer-events: none; border-radius: 999px; filter: blur(90px); opacity: .24; background: conic-gradient(from 200deg, var(--color-spin-top), var(--color-spin-middle), var(--color-spin-bottom), var(--color-spin-top)); }
    .signin-titlebar { display: flex; align-items: center; gap: .6rem; height: 44px; padding: 0 1rem; border-bottom: 1px solid var(--color-line-soft); font-size: 13px; color: var(--color-ink-2); }
    .signin-body { display: grid; gap: 1.25rem; padding: clamp(1.25rem, 4vw, 1.75rem); }
    .account .signin .provider { width: 100%; height: 46px; gap: 10px; font-size: 15px; cursor: pointer; }
    .signin .provider:disabled { opacity: .55; cursor: default; }
    .signin .provider[aria-busy=true] > svg { display: none; }
    .signin .provider[aria-busy=true]::before { content: ""; width: 1rem; height: 1rem; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: account-spin .8s linear infinite; }
  </style>

  <script>
    import { accountRequest, currentSession, describe } from "../remote/accounts"

    const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!
    const error = $("#error")
    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-provider]")]

    const destination = () => {
      const path = sessionStorage.getItem("meldshell:after-sign-in")
      return path?.startsWith("/") && !path.startsWith("//") ? path : "/dashboard"
    }
    if (destination().startsWith("/device")) {
      $("#title").textContent = "Connect your computer."
      $("#lede").textContent = "Sign in with the account this computer should belong to. You’ll confirm it on the next page."
    }

    // Better Auth returns here with an error code when the provider or account linking refuses.
    const failure = new URL(location.href).searchParams.get("error")
    if (failure)
      error.textContent = /not_linked|unable_to_link/i.test(failure)
        ? "That provider’s email isn’t verified, so it can’t join the account that already uses it. Sign in with the provider you used before."
        : "Sign-in didn’t finish. Try again."

    // Already signed in: continue straight to where the visitor was going.
    void currentSession()
      .then((session) => {
        if (!session) return
        const path = destination()
        sessionStorage.removeItem("meldshell:after-sign-in")
        location.assign(path)
      })
      .catch(() => undefined)
    // Both providers show straight away; the config only hides the ones this site hasn't set up.
    void accountRequest("/api/remote/v1/config")
      .then((config: { providers: string[] }) => {
        for (const button of buttons) button.hidden = !config.providers.includes(button.dataset.provider!)
        if (config.providers.length === 0) error.textContent = "Sign-in isn’t configured on this site yet."
      })
      .catch((cause) => { error.textContent = describe(cause) })

    for (const button of buttons)
      button.addEventListener("click", () => {
        error.textContent = ""
        for (const item of buttons) item.disabled = true
        button.setAttribute("aria-busy", "true")
        void accountRequest("/api/auth/sign-in/social", {
          provider: button.dataset.provider,
          callbackURL: new URL(destination(), location.origin).href,
          errorCallbackURL: new URL("/sign-in", location.origin).href,
        })
          .then((data: { url?: string }) => {
            sessionStorage.removeItem("meldshell:after-sign-in")
            if (data.url) location.assign(data.url)
          })
          .catch((cause) => {
            error.textContent = describe(cause)
            for (const item of buttons) item.disabled = false
            button.removeAttribute("aria-busy")
          })
      })
  </script>
</AccountPage>
