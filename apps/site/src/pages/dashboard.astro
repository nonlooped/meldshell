---
import AccountPage from "../components/AccountPage.astro"
import Lucide from "../components/Lucide.astro"
import Wordmark from "../components/Wordmark.astro"
---

<AccountPage title="Your devices" description="Open a computer running MeldShell." variant="site">
  <Fragment slot="nav">
    <span class="who" id="who"></span>
    <button type="button" class="nav-link" id="sign-out">Sign out</button>
  </Fragment>

  <div class="devices-page">
    <div class="devices-head">
      <div>
        <h1 class="display">Your devices.</h1>
        <p class="prose-lede" id="summary">Loading your computers…</p>
      </div>
      <button type="button" class="btn btn-secondary add" id="add" hidden aria-controls="setup" aria-expanded="false">
        <Lucide name="Plus" size={16} strokeWidth={2} />
        <span id="add-label">Add a computer</span>
      </button>
    </div>

    <p class="notice" data-tone="error" role="alert" id="error"></p>

    <div class="devices-stage">
      <div aria-hidden="true" class="devices-glow"></div>
      <div id="loading" class="devices" aria-hidden="true">
        <div class="device skeleton"></div>
        <div class="device skeleton"></div>
      </div>
      <ul id="devices" class="devices" aria-label="Computers" hidden></ul>
    </div>

    <section id="setup" class="ui-window setup" hidden aria-labelledby="setup-title">
      <div class="window-bar">
        <Wordmark size={16} />
        <h2 id="setup-title">Connect a computer</h2>
        <span class="pill" id="setup-badge">Getting started</span>
      </div>
      <div class="setup-body">
        <p class="setup-lede">Remote access works through MeldShell on the computer where your workspaces live. Connect it once and it appears here.</p>
        <div class="grid gap-6">
          <ol class="steps">
            <li>
              <strong>Open MeldShell on that computer</strong>
              <span>Keep it running while you work remotely. Your agents run there, not in this browser.</span>
            </li>
            <li>
              <strong>Go to Settings → Account &amp; devices</strong>
              <span>Choose <em>Sign in with your browser</em>, then open the link it shows.</span>
            </li>
            <li>
              <strong>Confirm the code</strong>
              <span>Check the code matches and choose <em>Connect this computer</em>.</span>
            </li>
          </ol>
          <div class="waiting" role="status" id="waiting">
            <span class="spinner" aria-hidden="true"></span>
            Waiting for a computer to connect. This page updates by itself.
          </div>
          <details class="server">
            <summary>Setting up a server without a screen?</summary>
            <p class="muted">Run the headless host as the user that owns your workspaces and provider logins, then open the link it prints:</p>
            <pre><code>npm run host -- link --control <span id="control-url"></span> --data-dir /var/lib/meldshell
npm run host -- --data-dir /var/lib/meldshell --workspace /srv/project</code></pre>
          </details>
        </div>
      </div>
    </section>

    <p class="muted footnote">
      Closing this page never stops your agents. Traffic passes through the MeldShell relay, whose operator can read forwarded prompts and output; provider credentials stay on your computers.
    </p>
  </div>

  <dialog id="revoke-dialog" aria-labelledby="revoke-title">
    <form method="dialog" class="grid gap-4">
      <h2 id="revoke-title">Remove this computer?</h2>
      <p class="muted" id="revoke-body"></p>
      <div class="flex justify-end gap-2">
        <button class="btn btn-ghost" value="cancel" autofocus>Cancel</button>
        <button class="btn btn-danger" value="confirm">Remove access</button>
      </div>
    </form>
  </dialog>

  <dialog id="rename-dialog" aria-labelledby="rename-title">
    <form id="rename-form" class="grid gap-4" novalidate>
      <div>
        <h2 id="rename-title">Rename this computer</h2>
        <p class="muted mt-2">The name shows here and in MeldShell on that computer the next time it signs in. Signing in again keeps it.</p>
      </div>
      <label class="field">
        Name
        <input name="name" autocomplete="off" required maxlength="100" placeholder="Work laptop" />
      </label>
      <p class="notice" data-tone="error" role="alert" id="rename-error"></p>
      <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-ghost" id="rename-cancel">Cancel</button>
        <button type="submit" class="btn btn-primary" id="rename-save">Save name</button>
      </div>
    </form>
  </dialog>

  <style is:global>
    .account .nav-link { display: inline-flex; align-items: center; height: 32px; padding: 0 10px; border-radius: 7px; color: var(--color-ink-2); cursor: pointer; transition: color .15s, background-color .15s; }
    .account .nav-link:hover { color: var(--color-ink); background: var(--color-hover); }
    .account .who { font-size: 13.5px; }
    @media (max-width: 639px) { .account .who { display: none; } }

    .devices-page { display: grid; align-content: start; gap: 2.5rem; padding-top: clamp(1.5rem, 6vh, 4rem); }
    .devices-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem 2rem; }
    .account .devices-head h1 { font-size: clamp(44px, 6vw, 84px); line-height: .94; font-weight: 500; letter-spacing: -.03em; }
    .devices-head .prose-lede { margin-top: 1.5rem; max-width: 46ch; }
    .account .devices-head .add { height: 46px; padding: 0 20px; gap: 10px; font-size: 15px; }

    .account .devices-head .add svg { transition: rotate .15s; }
    .account .devices-head .add[aria-expanded=true] svg { rotate: 45deg; }

    .devices-stage { position: relative; }
    .devices-stage:not(:has(> .devices:not([hidden]))) { display: none; }
    .devices-glow { position: absolute; inset: -20% 10%; z-index: -1; pointer-events: none; border-radius: 999px; filter: blur(110px); opacity: .16; background: conic-gradient(from 200deg, var(--color-spin-top), var(--color-spin-middle), var(--color-spin-bottom), var(--color-spin-top)); }
    .account .devices { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); list-style: none; padding: 0; }
    .account .device { display: grid; grid-template-rows: auto 1fr; min-width: 0; }
    .account .device.skeleton { height: 10.5rem; border-radius: var(--radius-window); background: linear-gradient(90deg, var(--color-hover), rgb(255 255 255 / .07), var(--color-hover)); background-size: 200% 100%; animation: account-shimmer 1.4s ease-in-out infinite; }
    @keyframes account-shimmer { to { background-position: -200% 0; } }
    @media (prefers-reduced-motion: reduce) { .account .device.skeleton { animation: none; } }
    .account .device[data-state=offline] { background: var(--color-desktop); box-shadow: none; }
    .account .window-bar { display: flex; align-items: center; gap: .6rem; min-width: 0; height: 44px; padding: 0 .75rem 0 1rem; border-bottom: 1px solid var(--color-line-soft); color: var(--color-ink-2); }
    .account .window-bar h2 { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 13.5px/1 var(--font-sans); color: var(--color-ink); }
    .account .device[data-state=offline] .window-bar h2 { color: var(--color-ink-2); }
    .account .device-body { display: grid; align-content: space-between; gap: 1.25rem; padding: 1.1rem 1rem 1rem; }
    .account .device-meta { font-size: 15px; color: var(--color-ink-2); line-height: 1.5; }
    .account .device-meta small { display: block; margin-top: .2rem; font-size: 13px; color: var(--color-ink-3); }
    .account .device-actions { display: flex; align-items: center; gap: .5rem; }
    .account .device-actions .btn-primary { flex: 1; height: 2.75rem; font-size: 15px; }
    .account .device-actions .btn-ghost:first-child { margin-right: auto; }
    .account .device-actions .btn-ghost { margin-left: auto; }
    .account .device-actions .btn-ghost + .btn-ghost { margin-left: 0; }
    .account .device-actions .btn-ghost .lucide { flex: none; }

    .account .setup { overflow: hidden; }
    .account .setup .window-bar h2 { font-size: 14px; }
    .account .setup-body { display: grid; gap: 1.75rem; padding: clamp(1.25rem, 4vw, 2rem); }
    @media (min-width: 900px) { .account .setup-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 3rem; } }
    .account .setup-lede { font-size: 17px; line-height: 1.55; color: var(--color-ink-2); text-wrap: pretty; max-width: 34ch; }
    .account .steps { list-style: none; padding: 0; counter-reset: step; display: grid; gap: 1.1rem; }
    .account .steps li { counter-increment: step; display: grid; grid-template-columns: 1.9rem 1fr; column-gap: .9rem; row-gap: .2rem; }
    .account .steps li::before { content: counter(step); grid-row: span 2; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; border: 1px solid var(--color-line-strong); font: 500 .8125rem var(--font-mono); color: var(--color-ink-2); }
    .account .steps strong { font-weight: 500; padding-top: .3rem; }
    .account .steps span { grid-column: 2; font-size: .875rem; color: var(--color-ink-2); line-height: 1.55; }
    .account .steps em { font-style: normal; color: var(--color-ink); }
    .account .waiting { display: flex; align-items: center; gap: .7rem; font-size: .875rem; color: var(--color-ink-2); }
    .account .server summary { font-size: .875rem; color: var(--color-ink-2); }
    .account .server[open] summary { margin-bottom: .75rem; }
    .account .server pre { margin-top: .75rem; padding: .9rem 1rem; overflow-x: auto; font: .8125rem/1.7 var(--font-mono); border-radius: var(--radius-row); background: rgb(0 0 0 / .3); border: 1px solid var(--color-line); }
    .account .footnote { max-width: 46rem; margin-top: 1rem; }

    .account dialog { margin: auto; width: min(26rem, calc(100vw - 2rem)); padding: 1.5rem; color: var(--color-ink); background: #1f1f21; border: 1px solid var(--color-line-strong); border-radius: var(--radius-window); box-shadow: 0 30px 80px rgb(0 0 0 / .5); }
    .account dialog::backdrop { background: rgb(0 0 0 / .55); backdrop-filter: blur(2px); }
  </style>

  <script>
    import { accountRequest, describe, listDevices, MAX_DEVICE_NAME, relativeTime, renameDevice, requireSession, ServiceUnavailable, signOut, type Device } from "../remote/accounts"

    const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!
    const list = $<HTMLUListElement>("#devices")
    const error = $("#error")
    const setup = $("#setup")
    const add = $<HTMLButtonElement>("#add")
    const dialog = $<HTMLDialogElement>("#revoke-dialog")
    const renameDialog = $<HTMLDialogElement>("#rename-dialog")
    const renameForm = $<HTMLFormElement>("#rename-form")
    const renameInput = renameForm.querySelector<HTMLInputElement>("input")!
    const renameError = $("#rename-error")
    $("#control-url").textContent = location.origin

    const icon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M2 20h20"/></svg>`
    const pencil = `<svg class="lucide" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>`
    let devices: Device[] | null = null
    let previous = ""
    let setupOpen = false

    function render() {
      if (!devices) return
      // Re-render when the list changes or relative times move to a new minute.
      const fingerprint = JSON.stringify(devices) + Math.floor(Date.now() / 60_000)
      if (fingerprint === previous) return
      previous = fingerprint
      const online = devices.filter((device) => device.online).length
      $("#loading").hidden = true
      list.hidden = devices.length === 0
      add.hidden = devices.length === 0
      setup.hidden = devices.length > 0 && !setupOpen
      $("#setup-badge").textContent = devices.length ? "Another computer" : "Getting started"
      $("#waiting").hidden = devices.length > 0
      $("#summary").textContent = devices.length === 0
        ? "You’re signed in. Connect a computer to control it from here."
        : online === 0
          ? devices.length === 1
            ? "Your computer is offline. Open MeldShell on it to reach it from here."
            : `None of your ${devices.length} computers are online. Open MeldShell on one to reach it.`
          : `${online} of ${devices.length} online. Choose a computer to open its inbox.`
      list.replaceChildren(...[...devices].sort((a, b) => Number(b.online) - Number(a.online)).map(renderDevice))
    }

    function renderDevice(device: Device) {
      const state = device.online ? "online" : "offline"
      const item = document.createElement("li")
      item.className = "ui-window device"
      item.dataset.state = state
      const bar = document.createElement("div")
      bar.className = "window-bar"
      const glyph = document.createElement("span")
      glyph.className = "contents"
      glyph.innerHTML = icon
      const name = document.createElement("h2")
      name.textContent = device.name
      name.title = device.name
      const pill = document.createElement("span")
      pill.className = "pill"
      pill.dataset.state = state
      pill.innerHTML = `<span class="dot" aria-hidden="true"></span>${device.online ? "Online" : "Offline"}`
      bar.append(glyph, name, pill)

      const body = document.createElement("div")
      body.className = "device-body"
      const meta = document.createElement("p")
      meta.className = "device-meta"
      meta.textContent = device.online ? "Ready now" : device.lastSeen ? `Last seen ${relativeTime(device.lastSeen)}` : "Hasn’t connected yet"
      if (!device.online) {
        const hint = document.createElement("small")
        hint.textContent = "Open MeldShell on this computer to reconnect."
        meta.append(hint)
      }
      const actions = document.createElement("div")
      actions.className = "device-actions"
      if (device.online) {
        const open = document.createElement("a")
        open.className = "btn btn-primary"
        open.href = `/workspace?device=${encodeURIComponent(device.id)}`
        open.textContent = "Open"
        open.setAttribute("aria-label", `Open ${device.name}`)
        actions.append(open)
      }
      const rename = document.createElement("button")
      rename.type = "button"
      rename.className = "btn btn-ghost btn-sm"
      rename.innerHTML = `${pencil}<span>Rename</span>`
      rename.setAttribute("aria-label", `Rename ${device.name}`)
      rename.addEventListener("click", () => openRename(device, rename))
      const remove = document.createElement("button")
      remove.type = "button"
      remove.className = "btn btn-ghost btn-sm"
      remove.textContent = "Remove"
      remove.setAttribute("aria-label", `Remove ${device.name}`)
      remove.addEventListener("click", () => confirmRevoke(device, remove))
      actions.append(rename, remove)
      body.append(meta, actions)
      item.append(bar, body)
      return item
    }

    function confirmRevoke(device: Device, trigger: HTMLButtonElement) {
      $("#revoke-body").textContent = `${device.name} will disconnect from your account and any open browser sessions. Its agents and conversations aren’t affected. To use it remotely again, sign in from MeldShell on that computer.`
      dialog.returnValue = ""
      dialog.showModal()
      dialog.addEventListener("close", () => {
        trigger.focus()
        if (dialog.returnValue !== "confirm") return
        trigger.disabled = true
        trigger.setAttribute("aria-busy", "true")
        void accountRequest(`/api/remote/v1/devices/${encodeURIComponent(device.id)}`, undefined, "DELETE")
          .then(poll)
          .catch((cause) => {
            error.textContent = describe(cause)
            trigger.disabled = false
            trigger.removeAttribute("aria-busy")
          })
      }, { once: true })
    }

    let renaming: { device: Device; trigger: HTMLButtonElement } | null = null
    function openRename(device: Device, trigger: HTMLButtonElement) {
      renaming = { device, trigger }
      renameInput.value = device.name
      renameInput.maxLength = MAX_DEVICE_NAME
      renameError.textContent = ""
      renameDialog.showModal()
      renameInput.select()
    }
    $("#rename-cancel").addEventListener("click", () => renameDialog.close())
    renameDialog.addEventListener("close", () => {
      renaming?.trigger.focus()
      renaming = null
    })
    renameForm.addEventListener("submit", (event) => {
      event.preventDefault()
      if (!renaming) return
      const name = renameInput.value.trim()
      if (!name) {
        renameError.textContent = "Give this computer a name."
        renameInput.focus()
        return
      }
      if (name === renaming.device.name) return renameDialog.close()
      const save = $<HTMLButtonElement>("#rename-save")
      save.disabled = true
      save.setAttribute("aria-busy", "true")
      void renameDevice(renaming.device.id, name)
        .then(async () => {
          renameDialog.close()
          await poll()
        })
        .catch((cause) => { renameError.textContent = describe(cause) })
        .finally(() => {
          save.disabled = false
          save.removeAttribute("aria-busy")
        })
    })

    let refreshing = false
    async function poll() {
      if (refreshing) return
      refreshing = true
      try {
        devices = await listDevices()
        error.textContent = ""
        render()
      } catch (cause) {
        error.textContent = cause instanceof ServiceUnavailable ? `${describe(cause)} Retrying…` : describe(cause)
      } finally {
        refreshing = false
      }
    }

    add.addEventListener("click", () => {
      setupOpen = !setupOpen
      add.setAttribute("aria-expanded", String(setupOpen))
      $("#add-label").textContent = setupOpen ? "Hide instructions" : "Add a computer"
      setup.hidden = !setupOpen
      if (setupOpen) setup.scrollIntoView({ behavior: "smooth", block: "start" })
    })
    $("#sign-out").addEventListener("click", () => {
      void signOut().catch((cause) => { error.textContent = describe(cause) })
    })

    let timer: ReturnType<typeof setInterval> | undefined
    void requireSession()
      .then(async (session) => {
        $("#who").textContent = session.user.email
        await poll()
        // Presence changes are rare; a slow poll keeps the account API within its free request quota.
        timer = setInterval(() => { if (!document.hidden) void poll() }, 10_000)
      })
      .catch((cause) => {
        $("#loading").hidden = true
        $("#summary").textContent = ""
        error.textContent = describe(cause)
      })
    document.addEventListener("visibilitychange", () => { if (!document.hidden) void poll() })
    window.addEventListener("pagehide", () => clearInterval(timer), { once: true })
  </script>
</AccountPage>
