---
import "@meldshell/ui/styles.css"
---

<!doctype html>
<html lang="en" data-platform="web">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" /><meta name="theme-color" content="#161617" /><meta name="robots" content="noindex" /><title>MeldShell</title><link rel="icon" href="/favicon.svg" /></head>
  <body>
    <!-- Before the workspace is on screen, this page explains the connection. Afterwards the
         renderer's own title bar names the computer and reports the connection itself. -->
    <div id="remote-gate" data-state="connecting">
      <div class="gate-card">
        <span class="gate-spinner" aria-hidden="true"></span>
        <h1 id="gate-title">Connecting…</h1>
        <p id="gate-body">Reaching MeldShell on your computer.</p>
        <p id="gate-hint" hidden>Taking a while? Make sure MeldShell is open on that computer and connected to the internet.</p>
        <div class="gate-actions">
          <button type="button" id="gate-retry" hidden>Try again</button>
          <a href="/dashboard" id="gate-action">Back to your devices</a>
        </div>
      </div>
    </div>
    <div id="root"></div>
    <script>
      import appPackage from "../../../../package.json"
      import { describe, listDevices, requireSession } from "../remote/accounts"
      import { remoteApi, type RemoteState } from "../remote/transport"
      import type { RemoteClientStatus } from "@meldshell/ui"

      const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!
      let mounted = false
      let current: RemoteClientStatus = { state: "connecting", message: "Reaching MeldShell on your computer." }
      const listeners = new Set<(status: RemoteClientStatus) => void>()
      function show(state: RemoteState, message: string) {
        current = { state, message }
        for (const listener of listeners) listener(current)
        if (mounted) return
        const gate = $("#remote-gate")
        gate.dataset.state = state
        const ended = state === "ended"
        const offline = state === "offline" || state === "reconnecting"
        $("#gate-title").textContent = ended ? "Access ended" : offline ? "Your computer isn’t reachable" : "Connecting…"
        $("#gate-body").textContent = message
        $("#gate-retry").hidden = !ended
        if (ended || offline) $("#gate-hint").hidden = true
      }
      $("#gate-retry").addEventListener("click", () => location.reload())

      // Safari keeps the page's size when the on-screen keyboard opens and pans it instead, which
      // pushes the header off screen. The app is sized to what stays visible and follows the pan,
      // so the composer rests on the keyboard. A pinch zoom leaves the layout alone.
      const visible = window.visualViewport
      if (visible) {
        const root = $("#root")
        const fit = () => {
          const zoomed = Math.abs(visible.scale - 1) > 0.01
          root.style.height = zoomed ? "" : `${visible.height}px`
          root.style.transform = zoomed || visible.offsetTop === 0 ? "" : `translateY(${visible.offsetTop}px)`
        }
        visible.addEventListener("resize", fit)
        visible.addEventListener("scroll", fit)
        fit()
      }

      void (async () => {
        await requireSession()
        const id = new URL(location.href).searchParams.get("device")
        if (!id) { location.assign("/dashboard"); return }
        let deviceName = "Your computer"
        const named = listDevices().then((devices) => {
          const device = devices.find((item) => item.id === id)
          if (!device) return
          deviceName = device.name
          document.title = `${device.name} — MeldShell`
          if (!mounted && $("#remote-gate").dataset.state === "connecting")
            $("#gate-body").textContent = `Reaching MeldShell on ${device.name}.`
        }).catch(() => undefined)
        setTimeout(() => { if (!mounted && $("#remote-gate").dataset.state === "connecting") $("#gate-hint").hidden = false }, 8_000)

        let ready: () => void
        const connected = new Promise<void>(resolve => { ready = resolve })
        const remote = remoteApi(id, (message, state) => {
          show(state, message)
          if (state === "connected") ready()
        })
        window.meldshell = remote.api
        await connected
        window.meldshell = remote.forHost(await remote.api.getRemoteStatus().catch(() => null))
        await named
        const { mount } = await import("@meldshell/ui")
        mount({ version: appPackage.version }, {
          remote: {
            deviceName,
            devicesURL: "/dashboard",
            subscribe: (listener) => {
              listeners.add(listener)
              listener(current)
              return () => { listeners.delete(listener) }
            },
          },
        })
        mounted = true
        $("#remote-gate").hidden = true
      })().catch(cause => show("ended", describe(cause)))
    </script>
    <style is:global>
      #remote-gate { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 24px; background: var(--scrim, #161617); }
      #remote-gate[hidden] { display: none; }
      .gate-card { display: grid; justify-items: center; gap: 10px; max-width: 360px; text-align: center; }
      .gate-card h1 { margin: 6px 0 0; font: 600 20px/1.3 var(--font-display); color: var(--text-primary); }
      .gate-card p { margin: 0; font-size: 13px; line-height: 1.6; color: var(--text-secondary); }
      .gate-card #gate-hint { color: var(--text-tertiary); font-size: 12px; }
      .gate-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 10px; }
      .gate-actions a, .gate-actions button { display: inline-flex; align-items: center; height: 32px; padding: 0 14px; border: 1px solid var(--line); border-radius: var(--radius); background: transparent; color: var(--text-primary); font: inherit; font-size: 12.5px; cursor: default; }
      .gate-actions a:hover, .gate-actions button:hover { background: var(--surface-hover); border-color: var(--line-strong); }
      .gate-actions [hidden] { display: none; }
      .gate-spinner { width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line-strong); border-top-color: var(--text-primary); animation: remote-spin .8s linear infinite; }
      #remote-gate:is([data-state=ended], [data-state=offline], [data-state=reconnecting]) .gate-spinner { animation: none; border-color: var(--line-strong); }
      #remote-gate[data-state=ended] .gate-spinner { display: none; }
      @keyframes remote-spin { to { rotate: 1turn; } }
      @media (prefers-reduced-motion: reduce) { .gate-spinner { animation-duration: 3s !important; } }

      html[data-platform=web] #root { height: 100dvh; }
      @media (max-width: 640px) {
        html[data-platform=web] { --text-base: 14px; }
        html[data-platform=web] input, html[data-platform=web] textarea { font-size: 16px; }
        html[data-platform=web] [role=dialog] { max-width: calc(100vw - 24px); }
      }
    </style>
  </body>
</html>
