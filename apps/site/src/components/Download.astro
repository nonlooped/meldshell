---
/* One installer per platform. Links start at the releases page; scripts/release.ts points them
   at the latest installer and names its version, date, and size. */
import BrandIcon from "./BrandIcon.astro"
import Lucide from "./Lucide.astro"

interface Props {
  releases: string
  class?: string
}
const { releases, class: className } = Astro.props
const latest = `${releases}/latest`
---

<section id="download" class:list={["relative scroll-mt-16 px-5 sm:px-8", className]} aria-labelledby="download-heading">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-1/2 mx-auto h-[60%] max-w-[900px] -translate-y-1/2 rounded-full opacity-[0.14] blur-[120px] [background:conic-gradient(from_20deg,var(--color-spin-top),var(--color-spin-middle),var(--color-spin-bottom),var(--color-spin-top))]"
  ></div>
  <div class="panel relative mx-auto max-w-[880px] px-6 py-14 sm:px-14 sm:py-20 text-center">
    <h2 id="download-heading" class="display text-[clamp(34px,5vw,64px)]">Get MeldShell</h2>
    <p class="mt-4 text-[15.5px] leading-[1.55] text-ink-2">
      Free for Windows 11 and Linux. Uses the Codex, Claude Code and Cursor CLIs already on your
      machine.
    </p>

    <div class="mt-10 grid gap-3 sm:grid-cols-2 sm:gap-4">
      <a href={latest} class="tile" data-asset=".exe" data-reveal>
        <BrandIcon name="windows" size={26} />
        <span class="tile-text">
          <span class="tile-title">Download for Windows</span>
          <span class="tile-meta">Windows 11 · x64 installer<span data-asset-size></span></span>
        </span>
        <Lucide name="ArrowDownToLine" size={18} class="tile-arrow" />
      </a>
      <a href={latest} class="tile" data-asset=".AppImage" data-reveal>
        <BrandIcon name="linux" size={26} />
        <span class="tile-text">
          <span class="tile-title">Download for Linux</span>
          <span class="tile-meta">x64 AppImage<span data-asset-size></span></span>
        </span>
        <Lucide name="ArrowDownToLine" size={18} class="tile-arrow" />
      </a>
    </div>

    <p class="mt-7 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-[13px] text-ink-3">
      <span>Latest <span class="font-mono text-ink-2" data-release-version>release</span></span>
      <span class="text-ink-4">·</span>
      <span data-release-date>on GitHub</span>
      <span class="text-ink-4">·</span>
      <a href={releases} class="text-ink-2 underline decoration-ink-4 underline-offset-[3px] hover:decoration-ink">All releases</a>
    </p>
  </div>
</section>

<style>
  .panel {
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-window) + 6px);
    background:
      radial-gradient(120% 90% at 50% 0%, rgb(255 255 255 / 0.04), transparent 60%),
      rgb(22 22 23 / 0.7);
    backdrop-filter: blur(24px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 30px 80px rgb(0 0 0 / 0.45);
  }
  @media (prefers-reduced-transparency: reduce) {
    .panel {
      background: var(--color-window);
      backdrop-filter: none;
    }
  }
  .tile {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-window);
    background: rgb(255 255 255 / 0.03);
    color: var(--color-ink);
    text-align: left;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      transform 0.15s;
  }
  .tile:hover {
    background: rgb(255 255 255 / 0.06);
    border-color: rgb(255 255 255 / 0.3);
    transform: translateY(-1px);
  }
  .tile:active {
    transform: translateY(0);
  }
  .tile-text {
    display: grid;
    gap: 3px;
    min-width: 0;
  }
  .tile-title {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .tile-meta {
    font-size: 12.5px;
    color: var(--color-ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tile-arrow {
    color: var(--color-ink-3);
    transition: transform 0.15s, color 0.15s;
  }
  .tile:hover .tile-arrow {
    color: var(--color-ink);
    transform: translateY(2px);
  }
</style>
