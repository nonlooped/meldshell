---
/* Official marks. Codex and Claude use the same icons as the desktop's ProviderIcon, and file
   types the same icons as its FileIcon; the rest come from the same packs. Marks keep their brand
   colours unless `mono` asks for currentColor. */
import claudeCode from "@iconify-icons/logos/claude-code"
import claude from "@iconify-icons/logos/claude-icon"
import cursor from "@iconify-icons/logos/cursor-icon"
import windows from "@iconify-icons/logos/microsoft-windows-icon"
import openai from "@iconify-icons/logos/openai-icon"
import github from "@iconify-icons/simple-icons/github"
import linux from "@iconify-icons/simple-icons/linux"
import typescript from "@iconify-icons/material-icon-theme/typescript"

const icons = { claude, claudeCode, cursor, github, linux, openai, typescript, windows } as const

interface Props {
  name: keyof typeof icons
  size?: number
  class?: string
  /** Draw in currentColor instead of the brand colour. */
  mono?: boolean
}

const { name, size = 24, class: className, mono = name === "cursor" } = Astro.props
const icon = icons[name]
const width = icon.width ?? 24
const height = icon.height ?? 24
/* Marks are square; a non-square viewBox is centred in a square box. */
const side = Math.max(width, height)
const viewBox = `${(width - side) / 2} ${(height - side) / 2} ${side} ${side}`
const body = mono ? icon.body.replace(/ fill="#[0-9a-fA-F]{3,8}"/g, "") : icon.body
---

<svg
  viewBox={viewBox}
  width={size}
  height={size}
  fill="currentColor"
  class:list={["shrink-0", className]}
  aria-hidden="true"
  set:html={body}
/>
