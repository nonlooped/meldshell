---
/* The desktop's working indicator: a 3×3 dot matrix whose pulse rises from the bottom-center
   cell, one gradient tone per row. Mirrors GradientSpinner in the renderer. */
interface Props {
  size?: number
  class?: string
}
const { size = 12, class: className } = Astro.props
const cell = size / 4
const rows = ["var(--color-spin-top)", "var(--color-spin-middle)", "var(--color-spin-bottom)"]
const dots = rows.flatMap((color, row) =>
  [0, 1, 2].map((column) => ({
    color,
    /* Distance from the wave origin becomes a phase lead of up to three quarters. */
    delay: -((2 - row + Math.abs(column - 1)) / 4) * 750,
  })),
)
---

<span
  aria-hidden="true"
  class:list={["inline-grid flex-none grid-cols-3", className]}
  style={`width:${size}px;height:${size}px;gap:${cell / 2}px`}
>
  {
    dots.map(({ color, delay }) => (
      <span class="rounded-full animate-gspin" style={`background:${color};animation-delay:${delay}ms`} />
    ))
  }
</span>
