---
import { getImage } from "astro:assets"
import socialCard from "../assets/meldshell-social-card.png"
import "../styles/global.css"

interface Props {
  title: string
  description: string
  softwareApplication?: boolean
}

const { title, description, softwareApplication = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url)
const og = await getImage({ src: socialCard, width: 1200, height: 630, format: "png" })
const ogImage = new URL(og.src, Astro.site ?? Astro.url)
const ogImageAlt = "MeldShell. Codex, Claude Code and Cursor, side by side."
const structuredData = softwareApplication
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "MeldShell",
      url: canonical,
      description,
      image: ogImage,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Windows 11 (x64), Linux (x64)",
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
      },
    }).replaceAll("<", "\\u003c")
  : undefined
---

<!doctype html>
<html lang="en" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="d5maEtSw1GYOz8UJ1bQmUxojH-Pk34YWDovb2u_cR_Q" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MeldShell" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#0f0f10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {structuredData && <script type="application/ld+json" set:html={structuredData}></script>}
  </head>
  <body class="min-h-dvh bg-desktop text-ink font-sans antialiased">
    <slot />
    <script>
      import "../scripts/motion"
      import "../scripts/stage"
      import "../scripts/reveal"
    </script>
  </body>
</html>
