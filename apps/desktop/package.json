{
  "name": "@meldshell/desktop",
  "version": "0.10.0",
  "private": true,
  "author": "MeldShell contributors",
  "description": "MeldShell desktop application",
  "desktopName": "com.meldshell.desktop",
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "lint": "biome lint .",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64",
    "preview": "electron-vite preview",
    "rebuild:native": "electron-builder install-app-deps",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.2",
    "@effect/rpc": "0.76.2",
    "@effect/sql-sqlite-node": "0.53.0",
    "@electron-toolkit/utils": "4.0.0",
    "@meldshell/contracts": "*",
    "@meldshell/core": "*",
    "@meldshell/host": "*",
    "@meldshell/provider-claude": "*",
    "@meldshell/provider-codex": "*",
    "@meldshell/provider-cursor": "*",
    "@meldshell/provider-runtime": "*",
    "better-sqlite3": "13.0.3",
    "cross-spawn": "7.0.6",
    "effect": "3.22.2",
    "electron-context-menu": "5.1.0",
    "electron-updater": "^6.8.9",
    "htmlparser2": "12.0.0",
    "ip-address": "10.7.2",
    "lru-cache": "11.5.3",
    "node-pty": "1.1.0",
    "p-limit": "7.3.3",
    "semver": "7.8.5",
    "which": "7.0.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@meldshell/ui": "*",
    "@tailwindcss/vite": "4.3.3",
    "@types/cross-spawn": "6.0.6",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  }
}
