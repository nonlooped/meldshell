{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/renderer/src/**/*", "../../packages/ui/src/env.d.ts", "src/preload/*.d.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    "jsx": "react-jsx",
    "paths": {
      "@meldshell/contracts": ["../../packages/contracts/src/index.ts"]
    }
  }
}
