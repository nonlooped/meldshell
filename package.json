{
  "name": "meldshell",
  "version": "0.14.0",
  "private": true,
  "author": "MeldShell contributors",
  "description": "A local desktop environment for concurrent coding-agent threads",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@meldshell/desktop",
    "check": "npm run knip && npm run check:fast && npm run build",
    "dev": "npm run dev --workspace=@meldshell/desktop",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "install:electron": "install-electron --no",
    "knip": "knip",
    "lint": "biome lint .",
    "package:win": "npm run package:win --workspace=@meldshell/desktop",
    "package:linux": "npm run package:linux --workspace=@meldshell/desktop",
    "postinstall": "npm run install:electron && npm run rebuild:native",
    "rebuild:native": "npm run rebuild:native --workspace=@meldshell/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "e2e run",
    "check:fast": "npm run lint && npm run format:check && npm run typecheck",
    "host": "npm run start --workspace=@meldshell/headless --",
    "control": "npm run dev --workspace=@meldshell/control",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:host": "node scripts/dev-host.mjs",
    "test:tooling": "node --import tsx --test tests/ci-scope.test.mjs tests/markdown-blocks.test.ts tests/onboarding.test.ts tests/dictation.test.ts tests/pull-requests.test.ts tests/review-notes.test.ts tests/changelog.test.ts tests/release-cli.test.mjs",
    "test:e2e:list": "e2e list",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/language-service": "0.87.3",
    "@types/node": "26.6.3",
    "concurrently": "10.0.5",
    "e2e": "0.15.1",
    "effect": "4.0.0",
    "knip": "6.38.0",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.146.0"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "lodash-es": "4.18.0"
  },
  "allowScripts": {
    "electron@44.4.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
