{
  "name": "meldshell",
  "version": "0.1.0",
  "private": true,
  "author": "MeldShell contributors",
  "description": "A local desktop environment for concurrent coding-agent threads",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build --workspace=@meldshell/desktop",
    "check": "npm run knip && npm run check:fast && npm run build",
    "dev": "npm run dev --workspace=@meldshell/desktop",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "install:electron": "install-electron --no",
    "knip": "knip",
    "lint": "biome lint .",
    "package:win": "npm run package:win --workspace=@meldshell/desktop",
    "package:linux": "npm run package:linux --workspace=@meldshell/desktop",
    "postinstall": "npm run install:electron && npm run rebuild:native",
    "rebuild:native": "npm run rebuild:native --workspace=@meldshell/desktop",
    "release": "node scripts/release.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --import tsx --test \"tests/**/*.test.ts\" \"tests/**/*.test.mjs\" \"packages/**/*.test.ts\" \"packages/**/*.test.mjs\" \"apps/desktop/src/**/*.test.ts\" \"apps/desktop/src/**/*.test.mjs\" \"apps/control/src/**/*.test.ts\" \"apps/site/src/remote/**/*.test.ts\"",
    "check:fast": "npm run lint && npm run format:check && npm run typecheck",
    "host": "npm run start --workspace=@meldshell/headless --",
    "control": "npm run start --workspace=@meldshell/control",
    "dev:all": "node --env-file-if-exists=apps/site/.env scripts/dev-all.mjs",
    "dev:host": "node --env-file-if-exists=apps/site/.env scripts/dev-host.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@effect/language-service": "0.87.2",
    "@effect/sql": "0.52.1",
    "@effect/sql-sqlite-node": "0.53.0",
    "@types/node": "24.10.1",
    "concurrently": "10.0.5",
    "effect": "3.22.1",
    "knip": "6.34.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "@effect/platform": "0.97.1",
    "better-sqlite3": "13.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron@44.1.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
