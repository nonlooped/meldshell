{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["packages/provider-codex/src/generated/**"],
  "ignoreBinaries": ["install-electron", "wsl.exe"],
  "includeEntryExports": true,
  // The compiler loads its plugin by name. SQLite and semver stay direct desktop dependencies
  // because bundled workers leave them external for Electron packaging. The site
  // pins cookie so Astro's prerender entry resolves its own major instead of the hoisted one.
  "ignoreDependencies": ["babel-plugin-react-compiler", "better-sqlite3", "cookie", "semver"],
  "workspaces": {
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/main/workers/*.ts", "src/**/*.test.mjs"],
      "project": ["src/**/*.{ts,tsx,mjs,css}"],
      // Imported through bundled workspace packages (host, providers); listing them keeps them
      // external and packaged. Core and provider-runtime are bundled workspace sources of the host.
      "ignoreDependencies": [
        "@effect/experimental",
        "@effect/platform",
        "@effect/rpc",
        "@effect/sql-sqlite-node",
        "@meldshell/core",
        "@meldshell/provider-runtime",
        "node-pty",
        "cross-spawn",
        "which",
        "ws"
      ]
    },
    "apps/host": {
      "entry": ["src/index.ts", "src/desktop.ts", "src/worker.ts"]
    },
    "apps/control": {
      "entry": ["test/*.test.ts"],
      // `cloudflare:workers` is a Workers runtime module, not a package.
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/site": {
      // Pages runs the /api function, which forwards to the account worker.
      "entry": ["functions/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/**/*.test.mjs"],
      "project": ["src/**/*.{ts,tsx,mjs,css}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
