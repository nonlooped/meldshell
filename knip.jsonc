{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["install-electron"],
  "includeEntryExports": true,
  // The compiler loads its plugin by name. SQLite, semver and which stay direct desktop
  // dependencies because bundled workers leave them external for Electron packaging. The site
  // pins cookie so Astro's prerender entry resolves its own major instead of the hoisted one.
  "ignoreDependencies": [
    "babel-plugin-react-compiler",
    "better-sqlite3",
    "cookie",
    "semver",
    "which"
  ],
  "workspaces": {
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/main/workers/*.ts", "src/**/*.test.mjs"],
      "project": ["src/**/*.{ts,tsx,mjs,css}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
