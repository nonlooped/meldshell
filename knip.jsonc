{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["install-electron"],
  "includeEntryExports": true,
  // The compiler loads its plugin by name. SQLite and semver stay direct desktop dependencies
  // because bundled workers leave them external for Electron packaging. The site
  // pins cookie so Astro's prerender entry resolves its own major instead of the hoisted one.
  "ignoreDependencies": [
    "babel-plugin-react-compiler",
    "better-sqlite3",
    "cookie",
    "semver"
  ],
  "workspaces": {
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/main/workers/*.ts", "src/**/*.test.mjs"],
      "project": ["src/**/*.{ts,tsx,mjs,css}"],
      // Imported through the bundled @meldshell/host package; listing them keeps them external
      // and packaged. Core and provider-runtime are bundled workspace sources of the host.
      "ignoreDependencies": [
        "@effect/experimental",
        "@effect/platform",
        "@effect/rpc",
        "@effect/sql-sqlite-node",
        "@meldshell/core",
        "@meldshell/provider-runtime",
        "ws"
      ]
    },
    "apps/control": {
      "entry": ["test/*.test.ts"],
      // `cloudflare:workers` is a Workers runtime module, not a package.
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/site": {
      // Pages runs the /api function, which forwards to the account worker.
      "entry": ["functions/**/*.ts"],
      // The remote workspace page bundles the desktop renderer, whose imports resolve against
      // the site's install on Pages. Its tsconfig extends the Electron toolkit preset.
      "ignoreDependencies": [
        "@base-ui-components/react",
        "@electron-toolkit/tsconfig",
        "@dnd-kit/dom",
        "@dnd-kit/react",
        "@iconify-icons/material-icon-theme",
        "@iconify/react",
        "@meldshell/projection",
        "@tanstack/react-query",
        "@tanstack/react-virtual",
        "@xterm/addon-fit",
        "@xterm/addon-unicode11",
        "@xterm/addon-web-links",
        "@xterm/xterm",
        "katex",
        "lucide-react",
        "mermaid",
        "react-diff-view",
        "react-error-boundary",
        "react-markdown",
        "react-resizable-panels",
        "refractor",
        "rehype-katex",
        "remark-gfm",
        "remark-math",
        "zustand"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
