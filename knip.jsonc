{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["packages/provider-codex/src/generated/**"],
  "ignoreBinaries": ["install-electron", "wsl.exe"],
  "includeEntryExports": true,
  // The compiler loads its plugin by name. semver stays a direct desktop dependency
  // because bundled workers leave it external for Electron packaging. The site
  // pins cookie so Astro's prerender entry resolves its own major instead of the hoisted one.
  "ignoreDependencies": ["babel-plugin-react-compiler", "cookie", "semver"],
  "workspaces": {
    ".": {
      "includeEntryExports": false,
      "entry": ["e2e.config.ts", "tests/e2e/**/*.e2e.ts", "tests/*.test.*"]
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/main/workers/*.ts"],
      "project": ["src/**/*.{ts,tsx,mjs,css}"],
      // Imported through bundled workspace packages (host, providers); listing them keeps them
      // external and packaged. Core and provider-runtime are bundled workspace sources of the host.
      "ignoreDependencies": [
        "@effect/sql-sqlite-node",
        "@meldshell/core",
        "@meldshell/provider-runtime",
        "node-pty",
        // Dictation's worker bundles transformers.js, which loads ONNX Runtime's native binding.
        "onnxruntime-common",
        "onnxruntime-node",
        "which",
        "ws"
      ]
    },
    "apps/host": {
      "entry": ["src/index.ts", "src/desktop.ts", "src/worker.ts"]
    },
    "apps/control": {
      // `cloudflare:workers` is a Workers runtime module, not a package.
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/site": {
      // Pages runs the /api function, which forwards to the account worker.
      "entry": ["functions/**/*.ts"]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx,mjs,css}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
